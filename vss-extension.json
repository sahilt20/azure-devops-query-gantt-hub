{
    "manifestVersion": 1,
    "id": "query-gantt-hub",
    "version": "1.2.41",
    "name": "Query Gantt Chart",
    "description": "Gantt Chart hub for Azure DevOps with robust start-date fallback, iteration-aware planning, rich hover details, effort rollup, and export support for Epic, Feature, PBI, Bug, and Task hierarchies.",
    "publisher": "SahilTanwar",
    "categories": [
        "Azure Boards"
    ],
    "targets": [
        {
            "id": "Microsoft.VisualStudio.Services"
        }
    ],
    "icons": {
        "default": "static/images/gantt-icon.png"
    },
    "scopes": [
        "vso.work"
    ],
    "demands": [
        "contribution/ms.vss-web.platform-common"
    ],
    "content": {
        "details": {
            "path": "overview.md"
        }
    },
    "contributions": [
        {
            "id": "query-gantt-hub",
            "type": "ms.vss-web.hub",
            "targets": [
                "ms.vss-work-web.work-hub-group"
            ],
            "properties": {
                "name": "Query Gantt Chart",
                "order": 99,
                "uri": "dist/QueryGanttHub.html",
                "icon": {
                    "light": "static/images/gantt-icon.png",
                    "dark": "static/images/gantt-icon.png"
                }
            }
        }
    ],
    "files": [
        {
            "path": "dist",
            "addressable": true
        },
        {
            "path": "static",
            "addressable": true
        },
        {
            "path": "overview.md",
            "addressable": true
        }
    ]
}
