{
  "name": "azure-devops-query-gantt-hub",
  "version": "1.0.0",
  "description": "Azure DevOps extension that adds a Gantt Chart view to Queries with effort rollup from Epic to Task",
  "main": "dist/QueryGanttHub.js",
  "scripts": {
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "start:dev": "webpack serve --mode development",
    "package": "tfx extension create --manifest-globs vss-extension.json",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "azure-devops-extension-api": "^4.233.0",
    "azure-devops-extension-sdk": "^4.0.2",
    "html2canvas": "^1.4.1",
    "react": "^16.14.0",
    "react-dom": "^16.14.0",
    "tfx-cli": "^0.23.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^16.14.0",
    "@types/react-dom": "^16.9.0",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.8.1",
    "rimraf": "^5.0.5",
    "style-loader": "^3.3.3",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/azure-devops-query-gantt-hub"
